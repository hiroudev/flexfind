{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlexFind",
  "version": "0.1.1",
  "identifier": "com.flexfind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "FlexFind",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "FlexFind 設定",
        "width": 820,
        "height": 520,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
